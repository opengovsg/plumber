{
  "name": "plumber",
  "private": true,
  "license": "AGPL-3.0",
  "engines": {
    "pnpm": ">=12.11.2"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "postinstall": "pnpm run gqlc",
    "setup": "node scripts/with-op-env.mjs --env setup pnpm --filter backend run setup",
    "dev": "node scripts/with-op-env.mjs turbo watch dev worker --continue",
    "dev:sample-env": "turbo watch dev worker --continue",
    "gqlc": "graphql-codegen --config gql-codegen.ts",
    "build": "turbo run build",
    "start": "pnpm --filter backend run start",
    "start:worker": "pnpm --filter backend run start:worker",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:unit test:integration",
    "test:ui": "vitest --ui",
    "migrate": "pnpm --filter backend run db:migrate",
    "teardown": "pnpm --filter backend run teardown"
  },
  "devDependencies": {
    "@1password/sdk": "0.5.0",
    "@eddeee888/gcg-typescript-resolver-files": "0.7.2",
    "@graphql-codegen/cli": "^5.0.7",
    "@types/node": "22.18.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "prettier": "^2.5.1",
    "rimraf": "^4.4.1",
    "tsc-alias": "^1.8.16",
    "turbo": "2.10.11",
    "typescript": "catalog:",
    "vitest": "^3.2.6",
    "wait-on": "^7.2.0"
  },
  "version": "1.97.0"
}
