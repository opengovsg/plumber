{
  "name": "plumber",
  "version": "1.81.0",
  "license": "AGPL-3.0",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "postinstall": "npm run gqlc",
    "setup": "npm run -w backend setup",
    "dev": "turbo watch dev worker --continue",
    "gqlc": "graphql-codegen --config gql-codegen.ts",
    "build": "turbo run build",
    "start": "npm run -w backend start",
    "start:worker": "npm run -w backend start:worker",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:unit test:integration",
    "test:ui": "vitest --ui",
    "migrate": "npm run -w backend db:migrate",
    "teardown": "npm run -w backend teardown"
  },
  "devDependencies": {
    "@eddeee888/gcg-typescript-resolver-files": "0.7.2",
    "@graphql-codegen/cli": "^5.0.7",
    "@types/node": "^22.18.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "prettier": "^2.5.1",
    "rimraf": "^4.4.1",
    "tsc-alias": "^1.8.16",
    "turbo": "2.10.11",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6",
    "wait-on": "^7.2.0"
  },
  "version": "1.83.0"
}
