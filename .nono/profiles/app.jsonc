{
  "meta": {
    "name": "plumber-app",
    // We sandbox the app with credential injection to prevent agents from using
    // code modification as a side channel (e.g. by logging process.env, or
    // doing filesystem reads/writes through nodejs).
    "description": "Sandbox for the Plumber app (frontend, backend, workers).",
    "version": "1.0.0"
  },
  "workdir": {
    "access": "readwrite"
  },
  "unsafe_macos_seatbelt_rules": [
    // Credential injection forcibly enables outbound connection blocking, but
    // we don't want this.
    // See https://github.com/nolabs-ai/nono/issues/1031
    "(allow network-outbound)",
    // Enable listening on arbitrary ports, to enable config-free port
    // assignment to different worktrees.
    "(allow network-bind)",
    "(allow network-inbound)"
  ],
  "network": {
    "block": false,
    "allow_domain": ["*"],
    "credentials": ["pair_foundry"],
    "custom_credentials": {
      "pair_foundry": {
        "upstream": "https://engine.pair.gov.sg",
        "credential_key": "env://PAIR_FOUNDRY_API_KEY",
        "inject_mode": "header",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "pair_rome_pair_action": {
        "upstream": "https://rome.pair.gov.sg",
        "credential_key": "cmd://pair_rome_pair_action",
        "env_var": "PAIR_ROME_PAIR_ACTION_CREDENTIALS",
        "inject_mode": "basic_auth",
        "endpoint_rules": [
          {
            "method": "POST",
            "path": "/api/public/otel/v1/traces?project_name=pairAction"
          }
        ]
      },
      "pair_rome_ai_builder": {
        "upstream": "https://rome.pair.gov.sg",
        "credential_key": "cmd://pair_rome_ai_builder",
        // Not used in code; just a placeholder
        "env_var": "PAIR_ROME_AI_BUILDER_CREDENTIALS",
        "inject_mode": "basic_auth",
        "endpoint_rules": [
          {
            "method": "POST",
            "path": "/api/public/otel/v1/traces?project_name=aiBuilder"
          },
          {
            "method": "GET",
            "path": "/api/public/v2/prompts/**?project_name=aiBuilder"
          }
        ]
      }
    }
  },
  "credential_capture": {
    "pair_rome_ai_builder": {
      "command": [
        "sh",
        "-c",
        "printf $PAIR_ROME_AI_BUILDER_PUBLIC_KEY:$PAIR_ROME_AI_BUILDER_SECRET_KEY"
      ],
      "timeout_secs": 15,
      "cache_ttl_secs": 0
    },
    "pair_rome_pair_action": {
      "command": [
        "sh",
        "-c",
        "printf $PAIR_ROME_PAIR_ACTION_PUBLIC_KEY:$PAIR_ROME_PAIR_ACTION_SECRET_KEY"
      ],
      "timeout_secs": 15,
      "cache_ttl_secs": 0
    }
  },
  "environment": {
    "set_vars": {
      "PAIR_FOUNDRY_API_KEY": "sk-key-pair-foundry"
    }
  },
  "groups": {
    "include": ["node_runtime"]
  },
  "commands": {
    // Allow npm scripts to run other scripts
    "allow": ["npm"]
  },
  // For vite's browser open functionality
  "open_urls": {
    "allow_localhost": true
  },
  "filesystem": {
    "allow": ["$HOME/.npm/_logs/"],
    // Stop nono from doing post-launch denial review
    "suppress_save_prompt": ["/"]
  },
  "diagnostics": {
    // Stop nono from doing post-launch denial review
    "suppress_system_services": ["user-preference-read"]
  }
}
