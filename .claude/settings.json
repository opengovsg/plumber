{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-hook-for-nvm.jq\"",
            "statusMessage": "nvm use"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gt create:*)",
      "Bash(gt track:*)",
      "Bash(gt parent:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run gqlc:*)",
      "Bash(pnpm --filter frontend run lint:*)",
      "Bash(pnpm --filter frontend run lint:fix:*)",
      "Bash(pnpm --filter backend run lint:*)",
      "Bash(pnpm --filter backend run lint:fix:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec vitest run:*)",
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status"
    ]
  }
}
