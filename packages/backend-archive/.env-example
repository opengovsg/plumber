APP_ENV=development
POSTGRES_DATABASE=plumber_dev
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_ENABLE_SSL=false

# LOCAL DEV S3 (MinIO)
AWS_ACCESS_KEY_ID=DUMMYIDEXAMPLE
AWS_SECRET_ACCESS_KEY=DUMMYEXAMPLEKEY
AWS_REGION=some-aws-region
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=...
S3_SECRET_KEY=...

# ARCHIVAL
ARCHIVE_ENABLED=false
ARCHIVE_DRY_RUN=true
ARCHIVE_RETENTION_DAYS=365
ARCHIVE_BATCH_SIZE=500
ARCHIVE_BATCH_SLEEP_MS=2000
ARCHIVE_BUCKET=plumber-development-archive-bucket
ARCHIVE_DELETED_FLOWS_ONLY=false
ARCHIVE_POSTGRES_READER_HOST=localhost
ARCHIVE_INTRA_BATCH_CONCURRENCY=10
