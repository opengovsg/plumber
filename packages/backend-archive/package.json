{
  "name": "backend-archive",
  "version": "1.81.2",
  "private": true,
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc && tsc-alias",
    "build:watch": "nodemon --watch \"src/**\" --ext \"ts,json\"",
    "test:unit": "vitest --config ./vitest.config.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "archive:backfill": "tsx src/scripts/archive-executions.ts",
    "archive:rehydrate": "DOTENV_CONFIG_PATH=\"${DOTENV_CONFIG_PATH:-.env}\" tsx src/scripts/rehydrate-execution.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:aws-sdk",
    "@plumber/types": "workspace:*",
    "dotenv": "catalog:",
    "knex": "catalog:",
    "luxon": "catalog:luxon",
    "p-limit": "catalog:",
    "pg": "catalog:pg",
    "winston": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/luxon": "catalog:luxon",
    "@types/node": "catalog:",
    "@types/pg": "catalog:pg",
    "nodemon": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
