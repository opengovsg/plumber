{
  "name": "backend-archive",
  "version": "1.81.2",
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc && tsc-alias",
    "build:watch": "nodemon --watch \"src/**\" --ext \"ts,json\"",
    "test:unit": "vitest --config ./vitest.config.ts",
    "lint": "eslint . --ignore-path ../../.eslintignore && tsc --noEmit",
    "lint:fix": "eslint . --fix --ignore-path ../../.eslintignore && tsc --noEmit",
    "archive:backfill": "ts-node --swc src/scripts/archive-executions.ts",
    "archive:rehydrate": "DOTENV_CONFIG_PATH=\"${DOTENV_CONFIG_PATH:-.env}\" ts-node --swc src/scripts/rehydrate-execution.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1027.0",
    "@plumber/types": "file:../types",
    "dotenv": "16.6.1",
    "knex": "2.4.2",
    "luxon": "2.5.2",
    "p-limit": "3.1.0",
    "pg": "^8.7.1",
    "winston": "^3.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@types/luxon": "^2.4.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.6.1",
    "nodemon": "^3.1.14",
    "rimraf": "^4.4.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  }
}
