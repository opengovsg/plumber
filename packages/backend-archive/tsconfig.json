{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["es2021", "ES2022.Error"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitAny": true,
    "noUncheckedSideEffectImports": true,
    "outDir": "dist",
    "rootDir": "src",
    // TS7 defaults strict to true; this repo was never written against full
    // strict mode. Pinned off so the version bump doesn't silently change
    // what's enforced.
    "strict": false,
    "types": [],
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2021",
    "typeRoots": [
      "../../node_modules/@types",
      "node_modules/@types",
      "node_modules/@plumber/types",
      "./src/types"
    ]
  },
  "include": ["src/**/*"]
}
