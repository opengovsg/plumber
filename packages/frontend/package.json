{
  "name": "frontend",
  "version": "1.81.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wait-on tcp:${DEV_BACKEND_PORT:-3000} && vite --host --force",
    "build": "tsc && vite build --mode=${VITE_MODE:-prod}",
    "build:lib": "vite build -c vite.config.lib.ts --mode=${VITE_MODE:-prod} && tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json",
    "prebuild": "rimraf ./build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "gen:theme-typings": "chakra-cli tokens ./src/theme/index.ts --out ./node_modules/@chakra-ui/styled-system/dist/theming.types.d.ts",
    "postinstall": "pnpm run gen:theme-typings"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:ai-sdk",
    "@chakra-ui/anatomy": "catalog:chakra-ui",
    "@chakra-ui/styled-system": "catalog:chakra-ui",
    "@chakra-ui/theme-tools": "catalog:chakra-ui",
    "@chakra-ui/utils": "catalog:chakra-ui",
    "@datadog/browser-rum": "catalog:",
    "@dnd-kit/core": "catalog:dnd-kit",
    "@dnd-kit/modifiers": "catalog:dnd-kit",
    "@dnd-kit/sortable": "catalog:dnd-kit",
    "@dnd-kit/utilities": "catalog:dnd-kit",
    "@emailens/engine": "catalog:",
    "@emotion/react": "catalog:emotion",
    "@emotion/styled": "catalog:emotion",
    "@floating-ui/react": "catalog:",
    "@fontsource/space-grotesk": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@opengovsg/confetti": "catalog:opengovsg",
    "@tanstack/react-table": "catalog:tanstack",
    "@tanstack/react-virtual": "catalog:tanstack",
    "@tiptap/core": "catalog:tiptap",
    "@tiptap/extension-document": "catalog:tiptap",
    "@tiptap/extension-hard-break": "catalog:tiptap",
    "@tiptap/extension-image": "catalog:tiptap",
    "@tiptap/extension-link": "catalog:tiptap",
    "@tiptap/extension-paragraph": "catalog:tiptap",
    "@tiptap/extension-placeholder": "catalog:tiptap",
    "@tiptap/extension-table": "catalog:tiptap",
    "@tiptap/extension-table-cell": "catalog:tiptap",
    "@tiptap/extension-table-header": "catalog:tiptap",
    "@tiptap/extension-table-row": "catalog:tiptap",
    "@tiptap/extension-text": "catalog:tiptap",
    "@tiptap/extension-underline": "catalog:tiptap",
    "@tiptap/pm": "catalog:tiptap",
    "@tiptap/react": "catalog:tiptap",
    "@tiptap/starter-kit": "catalog:tiptap",
    "ai": "catalog:ai-sdk",
    "clipboard-copy": "catalog:",
    "clsx": "catalog:",
    "compare-versions": "catalog:",
    "dedent": "catalog:",
    "downshift": "catalog:",
    "escape-html": "catalog:escape-html",
    "file-saver": "catalog:file-saver",
    "framer-motion": "catalog:",
    "fuzzysort": "catalog:",
    "lodash": "catalog:lodash",
    "lottie-web": "catalog:",
    "luxon": "catalog:luxon",
    "node-html-parser": "catalog:",
    "papaparse": "catalog:papaparse",
    "react-error-boundary": "catalog:",
    "react-helmet": "catalog:react-helmet",
    "react-hook-form": "catalog:",
    "react-icons": "catalog:",
    "react-json-tree": "catalog:",
    "react-markdown": "catalog:",
    "react-virtuoso": "catalog:",
    "remark-breaks": "catalog:",
    "remark-gfm": "catalog:",
    "sass": "catalog:",
    "streamdown": "catalog:",
    "typescript": "catalog:",
    "use-stick-to-bottom": "catalog:",
    "yup": "catalog:"
