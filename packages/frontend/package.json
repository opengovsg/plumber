  "devDependencies": {
    "@chakra-ui/cli": "catalog:chakra-ui",
    "@remix-run/router": "catalog:",
    "@plumber/types": "workspace:*",
    "@types/escape-html": "catalog:escape-html",
    "@types/file-saver": "catalog:file-saver",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:lodash",
    "@types/luxon": "catalog:luxon",
    "@types/papaparse": "catalog:papaparse",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react-dom",
    "@types/react-helmet": "catalog:react-helmet",
    "@vitejs/plugin-react-swc": "catalog:",
    "type-fest": "catalog:",
    "vite": "catalog:",
    "vite-plugin-package-version": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  },
  "peerDependencies": {
    "@apollo/client": "catalog:apollo",
    "@chakra-ui/react": "catalog:chakra-ui",
    "@opengovsg/design-system-react": "catalog:opengovsg",
    "graphql": "catalog:",
    "launchdarkly-js-client-sdk": "catalog:launchdarkly",
    "launchdarkly-react-client-sdk": "catalog:launchdarkly",
    "react": "catalog:react",
    "react-dom": "catalog:react-dom",
    "react-router-dom": "catalog:",
    "zod": "catalog:"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "files": [
    "dist/lib"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/exports/index.d.ts",
      "import": "./dist/lib/exports/index.js"
    },
    "./style.css": "./dist/lib/frontend.css",
    "./*": {
      "types": "./dist/lib/exports/*.d.ts",
      "import": "./dist/lib/exports/*.js"
    }
  }
}
