{
  "name": "frontend",
  "version": "1.79.0",
  "type": "module",
  "scripts": {
    "dev": "wait-on tcp:${DEV_BACKEND_PORT:-3000} && vite --host --force",
    "build": "tsc && vite build --mode=${VITE_MODE:-prod}",
    "build:lib": "vite build -c vite.config.lib.ts --mode=${VITE_MODE:-prod} && tsc-alias -p tsconfig.lib.json",
    "prebuild": "rimraf ./build",
    "lint": "eslint . --ignore-path ../../.eslintignore && tsc --noEmit",
    "lint:fix": "eslint . --fix --ignore-path ../../.eslintignore && tsc --noEmit",
    "test": "vitest",
    "gen:theme-typings": "chakra-cli tokens ./src/theme/index.ts",
    "postinstall": "npm run gen:theme-typings"
  },
  "dependencies": {
    "@ai-sdk/react": "2.0.86",
    "@datadog/browser-rum": "^5.2.0",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/modifiers": "7.0.0",
    "@dnd-kit/sortable": "8.0.0",
    "@emailens/engine": "0.9.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/space-grotesk": "4.5.13",
    "@hookform/resolvers": "^2.8.8",
    "@opengovsg/confetti": "^0.2.0",
    "@tanstack/react-table": "8.10.7",
    "@tanstack/react-virtual": "3.0.0-beta.68",
    "@tiptap/extension-hard-break": "2.1.12",
    "@tiptap/extension-image": "2.1.12",
    "@tiptap/extension-link": "2.10.4",
    "@tiptap/extension-placeholder": "2.1.12",
    "@tiptap/extension-table": "2.1.12",
    "@tiptap/extension-table-cell": "2.1.12",
    "@tiptap/extension-table-header": "2.1.12",
    "@tiptap/extension-table-row": "2.1.12",
    "@tiptap/extension-underline": "2.1.12",
    "@tiptap/react": "2.1.12",
    "@tiptap/starter-kit": "2.1.12",
    "ai": "5.0.81",
    "clipboard-copy": "^4.0.1",
    "compare-versions": "^4.1.3",
    "dedent": "1.5.1",
    "escape-html": "1.0.3",
    "file-saver": "2.0.5",
    "lodash": "^4.18.1",
    "lottie-web": "5.12.2",
    "luxon": "^2.3.1",
    "node-html-parser": "6.1.13",
    "papaparse": "5.4.1",
    "react-error-boundary": "6.1.1",
    "react-helmet": "6.1.0",
    "react-hook-form": "^7.17.2",
    "react-icons": "^4.12.0",
    "react-json-tree": "^0.18.0",
    "react-markdown": "8.0.7",
    "remark-breaks": "3.0.3",
    "remark-gfm": "3.0.1",
    "sass": "1.69.4",
    "streamdown": "1.4.0",
    "typescript": "^5.5.4",
    "use-stick-to-bottom": "^1.1.3",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^2.5.8",
    "@plumber/types": "file:../types",
    "@types/escape-html": "^1.0.4",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^26.0.15",
    "@types/lodash": "^4.14.182",
    "@types/luxon": "^2.0.8",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/react-helmet": "^6.1.11",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^2.5.1",
    "type-fest": "4.10.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-package-version": "1.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "@apollo/client": "3.13.9",
    "@chakra-ui/react": "2.6.1",
    "@opengovsg/design-system-react": "1.17.0",
    "graphql": "16.11.0",
    "launchdarkly-js-client-sdk": "3.1.3",
    "launchdarkly-react-client-sdk": "3.0.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.30.3",
    "zod": "4.4.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "files": [
    "dist/lib"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/exports/index.d.ts",
      "import": "./dist/lib/exports/index.js"
    },
    "./style.css": "./dist/lib/frontend.css",
    "./*": {
      "types": "./dist/lib/exports/*.d.ts",
      "import": "./dist/lib/exports/*.js"
    }
  }
}
