{
  "name": "backend-analytics",
  "version": "1.104.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist && pnpm run build:deps",
    "build": "tsc -p tsconfig.build.json",
    "build:deps": "pnpm --filter \"backend-analytics^...\" run build",
    "pretest:unit": "pnpm run build:deps",
    "test:unit": "vitest --config ./vitest.config.ts",
    "pretest:integration": "pnpm run build:deps",
    "test:integration": "vitest --config ./vitest.config.integration.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "pretypecheck": "pnpm run build:deps",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@plumber/backend-models": "workspace:*",
    "hyparquet-writer": "0.16.12",
    "knex": "catalog:",
    "luxon": "catalog:",
    "winston": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opengovsg/testcontainers": "0.2.0",
    "@types/luxon": "^2.4.0",
    "@types/node": "22.18.0",
    "hyparquet": "1.31.4",
    "pg": "catalog:",
    "rimraf": "^4.4.1",
    "testcontainers": "11.14.0",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
