{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["es2021", "ES2022.Error"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitAny": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2021",
    "typeRoots": [
      "../../node_modules/@types",
      "node_modules/@types",
      "node_modules/@plumber/types",
      "./src/types"
    ]
  },
  "include": ["src/**/*"]
}
