{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["es2021", "ES2022.Error", "ES2022.Object"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "outDir": "dist",
    "rootDir": "../backend/src",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2021",
    "typeRoots": ["../../node_modules/@types", "node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@plumber/types": ["node_modules/@plumber/types"],
      "ajv-formats": ["node_modules/ajv-formats"],
      "knex": ["node_modules/knex"],
      "objection": ["node_modules/objection"]
    }
  },
  "files": ["../backend/src/exports/models.ts"]
}
