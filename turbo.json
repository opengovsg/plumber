{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_MODE"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "outputs": [],
      "passThroughEnv": ["DD_*", "NODE_OPTIONS"]
    },
    "test:integration": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["DD_*", "NODE_OPTIONS"]
    },
    "test": {
      "outputs": [],
      "passThroughEnv": ["DD_*", "NODE_OPTIONS"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DEV_BACKEND_PORT"]
    },
    "worker": {
      "cache": false,
      "persistent": true
    }
  }
}
